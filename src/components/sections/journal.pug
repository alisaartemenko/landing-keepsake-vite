include ../../data/journal

section#journal.section.section--last(aria-labelledby="journal-title")
  .container
    h2#journal-title.section-title From the journal
    p.section__lead Notes on process, case studies and things that inspire us.
    .posts
      each post in posts
        article.post
          .post__thumb(role="img", aria-label="Journal preview", style=`--thumb-bg: ${post.bg}`)
          div
            p.post__meta #{ post.date } / #{ post.category }
            h3.post__title= post.title
            p.post__text Maecenas faucibus mollis interdum. Cum sociis natoque penatibus et magnis dis parturient montes.
            a.post__more(href="#journal") Read more ›
