include ../data/nav

header.header
  .container.header__bar
    input#nav-toggle.header__toggle(type="checkbox", aria-label="Toggle menu")
    a.logo(href="#top", aria-label="Keepsake home")
      b.logo__mark K
      | eepsake
    label.burger(for="nav-toggle", aria-hidden="true")
      i.burger__line
    nav.nav(aria-label="Main")
      ul.nav__list
        each item in navItems
          li
            a.nav__link(href=item.href, class={ "nav__link--active": item.active })= item.title
      .nav__extra
        a.btn(href="#contact") Contact us
        a.btn.btn--ghost(href="#top") Favourites
        .nav__say
          p.nav__cap Say hello
          p hello@keepsake.studio
          p +44 20 7946 0000
