include icon

//- name: web | motion | print, усе інше це іконка зі спрайта
mixin service-icon(name)
  case name
    when "web"
      svg(width="40", height="30", viewBox="0 0 40 30", aria-hidden="true")
        rect(x="2", y="2", width="36", height="24", fill="#8b95a1")
        rect(x="7", y="7", width="26", height="14", fill="#8fd18f")
    when "motion"
      svg(width="36", height="32", viewBox="0 0 36 32", aria-hidden="true")
        rect(x="2", y="2", width="32", height="28", fill="#5b6b82")
        rect(x="8", y="8", width="20", height="16", fill="#6aa7e0")
    when "print"
      svg(width="36", height="32", viewBox="0 0 36 32", aria-hidden="true")
        rect(x="8", y="2", width="20", height="10", fill="#f2c230")
        rect(x="2", y="12", width="32", height="14", fill="#7d8796")
    default
      +icon(name, 36).services__heart
